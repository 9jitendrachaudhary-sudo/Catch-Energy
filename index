<style>
:root{
  color-scheme: light only;
  --navy-950:#0D2140; --navy-900:#14315C; --navy-800:#1A3E74;
  --teal-700:#127C8C; --teal-500:#1FA3B5; --teal-400:#3FBCCB;
  --orange:#F58220; --orange-d:#DD6F0D;
  --ice:#F2F8F9; --ice-2:#E3F0F3; --line:#DBE7EA;
  --ink:#142433; --muted:#55707E; --faint:#8DA4AE; --white:#FFFFFF;
  --radius:12px; --maxw:1180px;
  --font-display:'Archivo',sans-serif; --font-body:'Manrope',sans-serif; --font-mono:'IBM Plex Mono',monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;background:#FFFFFF}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}
body{font-family:var(--font-body);color:var(--ink);background:#FFFFFF;line-height:1.65;font-size:16px;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:var(--font-display);line-height:1.14;color:var(--navy-900)}
a{color:inherit;text-decoration:none}
img,video{max-width:100%;display:block}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
.eyebrow{font-family:var(--font-mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--teal-500);display:flex;align-items:center;gap:10px;margin-bottom:16px}
.eyebrow::before{content:"";width:28px;height:2px;background:var(--orange);border-radius:2px}
section{padding:88px 0}
.section-head{max-width:680px;margin-bottom:48px}
.section-head h2{font-size:clamp(26px,3.4vw,38px);font-weight:700;letter-spacing:-.02em;margin-bottom:14px}
.section-head p{color:var(--muted);font-size:17px}
.btn{display:inline-flex;align-items:center;gap:9px;font-family:var(--font-display);font-weight:600;font-size:15.5px;padding:14px 28px;border-radius:999px;border:1px solid transparent;cursor:pointer;transition:background .18s,color .18s,border-color .18s,transform .18s}
.btn:hover{transform:translateY(-1px)}
.btn svg{width:15px;height:15px}
.btn-orange{background:var(--orange);color:#FFFFFF}
.btn-orange:hover{background:var(--orange-d);color:#FFFFFF}
.btn-ghost{border-color:rgba(255,255,255,.5);color:#FFFFFF}
.btn-ghost:hover{background:rgba(255,255,255,.12);color:#FFFFFF}
.btn-ghost-dark{border-color:var(--line);color:var(--navy-900);background:#FFFFFF}
.btn-ghost-dark:hover{border-color:var(--teal-500);color:var(--teal-700)}
.btn-teal{background:var(--teal-700);color:#fff}
.btn-teal:hover{background:var(--teal-500);color:#fff}
:focus-visible{outline:2px solid var(--teal-400);outline-offset:2px}

/* NAV */
header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.97);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:88px}
.logo img{height:52px;width:auto}
nav ul{display:flex;gap:28px;list-style:none;align-items:center}
nav ul a{font-size:15px;font-weight:600;color:var(--muted);transition:color .15s;cursor:pointer}
nav ul a:hover,nav ul a.active{color:var(--navy-900)}
nav ul a.active{color:var(--teal-700)}
.nav-cta{background:var(--orange);color:#FFFFFF!important;padding:11px 22px;border-radius:999px;font-family:var(--font-display);font-weight:600;font-size:14px}
.nav-cta:hover{background:var(--orange-d)}
.menu-btn{display:none;background:none;border:none;cursor:pointer;padding:8px}
.menu-btn svg{width:26px;height:26px;stroke:var(--navy-900)}

/* PAGES */
.page{display:none}
.page.active{display:block;animation:fadein .35s ease}
@keyframes fadein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* VIDEO HERO */
.vhero{position:relative;min-height:78vh;display:flex;align-items:center;overflow:hidden;background:var(--navy-950)}
.vhero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55}
.vhero::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,rgba(13,33,64,.92) 0%,rgba(13,33,64,.72) 45%,rgba(13,33,64,.35) 100%)}
.vhero .wrap{position:relative;z-index:2;padding-top:72px;padding-bottom:72px}
.vhero .eyebrow{color:var(--teal-400)}
.vhero h1{color:#fff;font-size:clamp(34px,5vw,58px);font-weight:800;letter-spacing:-.025em;margin-bottom:22px;max-width:760px}
.vhero h1 .hl{color:var(--orange)}
.vhero p.sub{font-size:18.5px;color:#C5D3E4;max-width:600px;margin-bottom:36px}
.vhero .kw{font-family:var(--font-mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#7F98B5;margin-top:44px;display:flex;gap:22px;flex-wrap:wrap}
.vhero .kw span{border-left:2px solid var(--orange);padding-left:10px}
.hero-btns{display:flex;gap:14px;flex-wrap:wrap}

/* STATS */
.stats{background:#fff;border-bottom:1px solid var(--line);padding:0}
.stats .wrap{display:flex;flex-wrap:wrap}
.stats .cell{flex:1;min-width:160px;padding:30px 24px;border-left:2px solid var(--orange)}
.stats .num{font-family:var(--font-display);font-weight:800;font-size:28px;color:var(--navy-900)}
.stats .lbl{font-family:var(--font-mono);font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--faint);margin-top:2px}

/* PILLARS (what we do) */
.pillars{background:var(--ice)}
.pil-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.pil{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:box-shadow .2s,transform .2s}
.pil:hover{box-shadow:0 16px 40px rgba(13,33,64,.12);transform:translateY(-3px)}
.pil .ph{height:190px;overflow:hidden;background:var(--navy-950)}
.pil .ph img{width:100%;height:100%;object-fit:cover;transition:transform .4s}
.pil:hover .ph img{transform:scale(1.05)}
.pil .bd{padding:26px;display:flex;flex-direction:column;flex:1}
.pil h3{font-size:19px;font-weight:700;margin-bottom:8px}
.pil p{font-size:14.5px;color:var(--muted);flex:1}
.pil .go{margin-top:16px;font-weight:700;color:var(--teal-700);font-size:14.5px;display:flex;align-items:center;gap:7px}
.pil .go svg{width:15px;height:15px}

/* SPLIT (image+text) */
.split{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.split .im{border-radius:16px;overflow:hidden;box-shadow:0 20px 50px rgba(13,33,64,.14)}
.split .im img{width:100%;height:100%;object-fit:cover;min-height:340px}
.split h2{font-size:clamp(24px,3vw,34px);font-weight:700;letter-spacing:-.02em;margin-bottom:14px}
.split p{color:var(--muted);margin-bottom:14px}
.ticks{list-style:none;margin:18px 0 26px}
.ticks li{display:flex;gap:11px;align-items:flex-start;padding:7px 0;font-weight:600;font-size:15px}
.ticks li svg{width:17px;height:17px;color:var(--teal-500);flex:none;margin-top:3px}

/* PRODUCT CARDS */
.prod-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.prod{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:box-shadow .2s}
.prod:hover{box-shadow:0 14px 38px rgba(13,33,64,.12)}
.prod .ph{height:200px;overflow:hidden;background:var(--navy-950);position:relative}
.prod .ph img{width:100%;height:100%;object-fit:cover}
.prod .tag{position:absolute;top:14px;left:14px;background:var(--orange);color:#fff;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;padding:5px 12px;border-radius:999px}
.prod .bd{padding:26px}
.prod h3{font-size:18px;font-weight:700;margin-bottom:8px}
.prod p{font-size:14px;color:var(--muted);margin-bottom:14px}
.prod .specs{list-style:none;border-top:1px solid var(--ice-2);padding-top:12px}
.prod .specs li{display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:5px 0}
.prod .specs .k{font-family:var(--font-mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--faint);padding-top:2px}
.prod .specs .v{font-weight:700;color:var(--navy-900);text-align:right}

/* SERVICES */
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.svc{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:28px;transition:border-color .2s,box-shadow .2s}
.svc:hover{border-color:var(--teal-400);box-shadow:0 12px 32px rgba(13,33,64,.09)}
.svc .ic{width:42px;height:42px;border-radius:12px;background:var(--ice);display:flex;align-items:center;justify-content:center;color:var(--teal-700);margin-bottom:16px}
.svc .ic svg{width:21px;height:21px}
.svc h3{font-size:17px;font-weight:700;margin-bottom:6px}
.svc p{font-size:14px;color:var(--muted)}

/* INDUSTRIES strip */
.indstrip{background:var(--navy-950);position:relative;overflow:hidden}
.indstrip::before{content:"";position:absolute;inset:0;background:radial-gradient(700px 400px at 90% 0%,rgba(245,130,32,.14),transparent 60%)}
.indstrip .wrap{position:relative}
.indstrip .section-head h2{color:#fff}
.indstrip .section-head p{color:#A9BCD6}
.chips{display:flex;flex-wrap:wrap;gap:12px}
.chip{border:1px solid rgba(255,255,255,.2);border-radius:999px;padding:12px 20px;font-size:14.5px;font-weight:600;color:#E8EFF7;display:flex;align-items:center;gap:10px}
.chip .dot{width:7px;height:7px;border-radius:50%;background:var(--teal-400)}

/* BLOG */
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.post{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;cursor:pointer;transition:box-shadow .2s,transform .2s}
.post:hover{box-shadow:0 14px 38px rgba(13,33,64,.12);transform:translateY(-3px)}
.post .ph{height:170px;overflow:hidden;background:var(--navy-950)}
.post .ph img{width:100%;height:100%;object-fit:cover}
.post .bd{padding:24px;display:flex;flex-direction:column;flex:1}
.post .cat{font-family:var(--font-mono);font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--orange);margin-bottom:8px}
.post h3{font-size:17px;font-weight:700;margin-bottom:8px;line-height:1.3}
.post p{font-size:13.5px;color:var(--muted);flex:1}
.post .read{margin-top:14px;font-size:13.5px;font-weight:700;color:var(--teal-700);display:flex;align-items:center;gap:6px}
.post .read svg{width:14px;height:14px}

/* ARTICLE */
.article-hero{background:linear-gradient(160deg,var(--navy-950),var(--navy-800));padding:80px 0 60px}
.article-hero .cat{font-family:var(--font-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--orange);margin-bottom:14px}
.article-hero h1{color:#fff;font-size:clamp(28px,4vw,44px);font-weight:800;letter-spacing:-.02em;max-width:820px}
.article-hero .meta{color:#8FA5C2;font-family:var(--font-mono);font-size:12.5px;margin-top:18px}
.article-body{max-width:780px;margin:0 auto;padding:64px 24px 40px;font-size:17px;line-height:1.8}
.article-body h2{font-size:26px;margin:44px 0 16px;letter-spacing:-.015em}
.article-body h3{font-size:20px;margin:32px 0 12px}
.article-body p{margin-bottom:18px;color:#2A3B49}
.article-body ul,.article-body ol{margin:0 0 18px 22px;color:#2A3B49}
.article-body li{margin-bottom:8px}
.article-body strong{color:var(--navy-900)}
.article-body .callout{background:var(--ice);border-left:4px solid var(--teal-500);border-radius:0 10px 10px 0;padding:20px 24px;margin:26px 0;font-size:15.5px}
.article-cta{background:var(--ice);border:1px solid var(--line);border-radius:16px;padding:32px;margin:44px 0 0;text-align:center}
.article-cta h3{margin-bottom:8px}
.article-cta p{color:var(--muted);margin-bottom:20px}
.back-link{display:inline-flex;align-items:center;gap:8px;font-weight:700;color:var(--teal-700);margin-bottom:8px;cursor:pointer}
.back-link svg{width:15px;height:15px}

/* CTA + CONTACT + FOOTER */
.cta{background:radial-gradient(800px 420px at 88% -20%,rgba(245,130,32,.2),transparent 60%),linear-gradient(150deg,var(--navy-950),var(--navy-800));text-align:center}
.cta h2{color:#fff;font-size:clamp(27px,3.6vw,42px);font-weight:800;letter-spacing:-.025em;margin-bottom:14px}
.cta p{color:#B9C9DE;font-size:17px;max-width:540px;margin:0 auto 34px}
.cta .btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:56px}
.contact-info .line{display:flex;gap:14px;align-items:flex-start;padding:16px 0;border-bottom:1px solid var(--ice-2);font-size:15px}
.contact-info .line svg{width:19px;height:19px;color:var(--teal-700);flex:none;margin-top:3px}
.contact-info .line .lbl{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);display:block}
.form-card{border:1px solid var(--line);border-radius:16px;padding:36px;background:#fff;box-shadow:0 16px 44px rgba(13,33,64,.08)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.field{margin-bottom:16px}
.field label{display:block;font-size:13px;font-weight:700;margin-bottom:6px;color:var(--navy-900)}
.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:8px;padding:12px 14px;font-family:var(--font-body);font-size:14.5px;color:var(--ink);background:var(--ice);transition:border-color .15s,background .15s}
.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--teal-500);background:#fff}
.form-note{font-size:12.5px;color:var(--faint);margin-top:14px}
footer{background:var(--navy-950);color:#93A7C0;padding:66px 0 34px;font-size:14px}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px;margin-bottom:48px}
.foot-grid h4{color:#fff;font-size:14px;font-weight:700;margin-bottom:16px}
.foot-grid ul{list-style:none}
.foot-grid ul li{margin-bottom:9px}
.foot-grid a{cursor:pointer}
.foot-grid a:hover{color:#fff}
.foot-brand .foot-logo{background:#fff;border-radius:12px;padding:10px 14px;display:inline-block}
.foot-brand .foot-logo img{height:46px;width:auto}
.foot-brand p{max-width:290px;margin-top:16px;font-size:13.5px}
.foot-bottom{border-top:1px solid rgba(255,255,255,.14);padding-top:26px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-family:var(--font-mono);font-size:11.5px;letter-spacing:.06em}
.pagehero{background:linear-gradient(160deg,var(--navy-950),var(--navy-800));padding:76px 0 64px;position:relative;overflow:hidden}
.pagehero::after{content:"";position:absolute;inset:0;background:radial-gradient(700px 380px at 92% -10%,rgba(245,130,32,.16),transparent 60%)}
.pagehero .wrap{position:relative;z-index:2}
.pagehero .eyebrow{color:var(--teal-400)}
.pagehero h1{color:#fff;font-size:clamp(30px,4.2vw,48px);font-weight:800;letter-spacing:-.02em;max-width:800px}
.pagehero p{color:#B9C9DE;font-size:17.5px;max-width:640px;margin-top:16px}

.reveal{opacity:0;transform:translateY(14px);transition:opacity .55s ease,transform .55s ease}
.reveal.in{opacity:1;transform:none}

@media(max-width:980px){
  .nav{height:74px}
  .logo img{height:44px}
  .split{grid-template-columns:1fr}
  .pil-grid,.prod-grid,.svc-grid,.blog-grid{grid-template-columns:repeat(2,1fr)}
  .contact-grid{grid-template-columns:1fr}
  .foot-grid{grid-template-columns:1fr 1fr}
  nav ul{display:none;position:absolute;top:80px;left:0;right:0;background:#fff;flex-direction:column;padding:20px 24px;gap:18px;border-bottom:1px solid var(--line);align-items:flex-start;z-index:60}
  nav ul.open{display:flex}
  .menu-btn{display:block}
  .vhero{min-height:64vh}
}
@media(max-width:600px){
  section{padding:60px 0}
  .pil-grid,.prod-grid,.svc-grid,.blog-grid{grid-template-columns:1fr}
  .form-row{grid-template-columns:1fr}
  .foot-grid{grid-template-columns:1fr}
  .logo img{height:38px}
  .stats .cell{min-width:130px;padding:20px 16px}
}
</style>
